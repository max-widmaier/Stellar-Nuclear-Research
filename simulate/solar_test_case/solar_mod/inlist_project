&star_job
  ! begin with a pre-main sequence model
    create_pre_main_sequence_model = .true.
    pgstar_flag = .false.
    show_eqns_and_vars_names = .true.

    initial_zfracs = 0
/ ! end of star_job namelist


&eos
  ! eos options
  ! see eos/defaults/eos.defaults

/ ! end of eos namelist


&kap
  ! kap options
  ! see kap/defaults/kap.defaults
  use_Type2_opacities = .true.
  Zbase = 0.01165712567958214

/ ! end of kap namelist


&controls
  ! Terminal outputs
  terminal_interval = 25
  write_header_frequency = 100

  ! see star/defaults/controls.defaults

  ! starting specifications
    initial_mass = 1 ! in Msun units
    initial_y = 0.27785996392712253
    initial_z = 0.01165712567958214

    z_fraction_c = 0.17793343879697887
    z_fraction_n = 0.05093475623793918
    z_fraction_o = 0.4413379196977048
    z_fraction_ne = 0.08425450098065938
    z_fraction_na = 0.0020521684793307366
    z_fraction_mg = 0.04970201894765329
    z_fraction_al = 0.0038172018263073868
    z_fraction_si = 0.05484797085146329
    z_fraction_s = 0.026712199490263672
    z_fraction_k = 0.0002836849392168556
    z_fraction_ca = 0.004938379329140164
    z_fraction_cr = 0.00136977481056526
    z_fraction_mn = 0.0008138635492215228
    z_fraction_fe = 0.0949866782692232
    z_fraction_ni = 0.006015443794332328

  ! when to stop
    max_age = 4603000000
    stop_at_phase_He_Burn = .true.
    max_model_number = 1000

  ! solver
     ! options for energy conservation (see MESA V, Section 3)
     energy_eqn_option = 'dedt'
     use_gold_tolerances = .true.

  ! output
    history_interval = 100
    photo_interval = 3000
    profile_interval = 100

/ ! end of controls namelist
